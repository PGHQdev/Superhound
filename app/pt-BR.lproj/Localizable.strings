/* Menu bar menu item; the argument is a version number such as 0.5.0 */
"Update to %@…" = "Atualizar para %@…";

/* Status in Settings */
"Updating search locations…" = "Atualizando locais de busca…";

/* Settings button that restores the default shortcut; the argument is a shortcut such as ⌥⌘V; 120 points wide */
"Use %@" = "Usar %@";

/* Settings status; Command, Option, and Control are the modifier keys */
"Use Command, Option, or Control with a key. Bare typing keys are not allowed." = "Use Command, Option ou Control com uma tecla. Teclas de digitação sozinhas não são permitidas.";

/* Search is the menu item title */
"Use Search in the menu bar while setting up your shortcut." = "Use Buscar na barra de menus enquanto configura o atalho.";

/* Settings check box */
"Use ⌘Space in place of Spotlight" = "Usar ⌘Space no lugar do Spotlight";

/* The argument is a version number such as 0.4.0 */
"Version %@ is the latest version." = "A versão %@ é a mais recente.";

/* State of a search location before its scan */
"Waiting" = "Aguardando";

/* Row detail; Return is the key name */
"Web address · Return to open in your browser" = "Endereço web · Return para abrir no navegador";

/* Settings row label; 115 points wide */
"Web search" = "Busca na web";

/* VoiceOver label of the search engine menu */
"Web search engine" = "Buscador da web";

/* Row detail; Return is the key name */
"Web search · Return to open in your browser" = "Busca na web · Return para abrir no navegador";

/* The argument is the installed version number */
"You have version %@. Superhound downloads the update, checks its signature, and opens again." = "Você tem a versão %@. O Superhound baixa a atualização, verifica a assinatura e abre de novo.";

/* Heading at the top of Settings */
"Your apps. Your folders. A shortcut away." = "Seus apps. Suas pastas. A um atalho de distância.";

/* VoiceOver kind of a result: an application; a noun */
"app" = "app";

/* VoiceOver kind of a result; a noun */
"file" = "arquivo";

/* VoiceOver kind of a result; a noun */
"folder" = "pasta";

/* VoiceOver kind of a result: a symbolic link or alias; a noun */
"link" = "link";

/* Error in the search panel; Privacy & Security → Automation is the place in System Settings */
"macOS blocked this command. Allow Superhound in Privacy & Security → Automation." = "O macOS bloqueou este comando. Permita o Superhound em Privacidade e Segurança → Automação.";

/* Keyboard Settings… is the button title */
"macOS did not save the Spotlight shortcut. Change it in Keyboard Settings…." = "O macOS não salvou o atalho do Spotlight. Altere-o em Ajustes de Teclado….";

/* The argument is an HTTP status code such as 500 */
"superhound.app answered with error %ld." = "superhound.app respondeu com o erro %ld.";

/* The argument is the system network error text */
"superhound.app could not be reached. %@" = "Não foi possível acessar superhound.app. %@";

/* No comment */
"superhound.app sent an answer that Superhound cannot read." = "superhound.app enviou uma resposta que o Superhound não consegue ler.";

/* No comment */
"superhound.app sent an answer that Superhound cannot read. Try again later." = "superhound.app enviou uma resposta que o Superhound não consegue ler. Tente novamente mais tarde.";
